<WixLocalization Culture="de-de"
	xmlns="http://wixtoolset.org/schemas/v4/wxl">

	<!-- Firewall Extension needs translation here -->
	<String Id="msierrFirewallCannotConnect" Overridable="yes" Value="Verbindung zur Windows-Firewall kann nicht hergestellt werden. ([2]   [3]   [4]   [5])" />

	<String Id="WixSchedFirewallExceptionsInstall" Overridable="yes" Value="Windows-Firewall wird konfiguriert" />
	<String Id="WixSchedFirewallExceptionsUninstall" Overridable="yes" Value="Windows-Firewall wird konfiguriert" />
	<String Id="WixRollbackFirewallExceptionsInstall" Overridable="yes" Value="Windows-Firewall-Konfiguration wird zurückgesetzt" />
	<String Id="WixExecFirewallExceptionsInstall" Overridable="yes" Value="Windows-Firewall-Konfiguration wird installiert" />
	<String Id="WixRollbackFirewallExceptionsUninstall" Overridable="yes" Value="Windows-Firewall-Konfiguration wird zurückgesetzt" />
	<String Id="WixExecFirewallExceptionsUninstall" Overridable="yes" Value="Windows-Firewall-Konfiguration wird deinstalliert" />

	<!-- Util Extension does not need translation here, because it is already in official WiX Toolkit -->
	<String Id="msierrSecureObjectsFailedCreateSD" Overridable="yes" Value="Sicherheitsdeskriptor [3]\[4] konnte nicht erstellt werden, Fehler: [2]" />
	<String Id="msierrSecureObjectsFailedSet" Overridable="yes" Value="Objekt-Sicherheitsdeskriptor [3] konnte nicht angewendet werden, Fehler: [2]" />
	<String Id="msierrSecureObjectsUnknownType" Overridable="yes" Value="Unbekannter Objekttyp [3], Fehler: [2]" />
</WixLocalization>
